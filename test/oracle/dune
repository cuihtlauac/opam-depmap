; Differential test against the original Python implementation (the oracle).
; Not part of @runtest: it depends on what the switch has installed.
;   dune build @oracle

(executable
 (name compare)
 (libraries opam-depmap))

(rule
 (alias oracle)
 (deps
  run.sh
  collect.py
  build_map.py
  packages
  expected_diffs
  compare.exe
  %{bin:opam-depmap}
  (universe))
 (action
  (run bash %{dep:run.sh} %{exe:compare.exe} %{bin:opam-depmap})))
