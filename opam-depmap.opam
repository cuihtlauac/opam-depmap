# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis:
  "Visualise the library dependency graph and binary footprint of an opam package"
description:
  "Builds the findlib dependency graph of any installed opam package -- or of the whole switch at once -- sizes each library by its compiled artifacts, and renders it two ways from one data.json: a self-contained interactive HTML treemap for humans, and a model-oriented report (JSON or a Markdown digest) carrying the pre-computed metrics the page shows only visually (depth, transitive footprint, fan-in, the size distribution). Installs as an opam plugin: opam depmap <pkg>."
maintainer: ["Cuihtlauac ALVARADO <cuihtlauac@tarides.com>"]
authors: ["Cuihtlauac ALVARADO <cuihtlauac@tarides.com>"]
license: "MIT"
homepage: "https://github.com/cuihtlauac/opam-depmap"
bug-reports: "https://github.com/cuihtlauac/opam-depmap/issues"
depends: [
  "dune" {>= "3.0"}
  "ocaml" {>= "4.14"}
  "opam-state" {>= "2.2" & < "2.7"}
  "opam-format" {>= "2.2" & < "2.7"}
  "opam-core" {>= "2.2" & < "2.7"}
  "ocamlfind"
  "cmdliner" {>= "1.1"}
  "alcotest" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/cuihtlauac/opam-depmap.git"
flags: plugin
