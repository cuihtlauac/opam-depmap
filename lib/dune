(library
 (name opam_depmap)
 (public_name opam-depmap)
 (libraries opam-state opam-format opam-core findlib unix str))

(rule
 (target template.ml)
 (deps template.html)
 (action
  (with-stdout-to
   %{target}
   (progn
    (echo "let html = {tpl|")
    (cat template.html)
    (echo "|tpl}\n")))))
